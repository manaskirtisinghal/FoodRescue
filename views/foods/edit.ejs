<% layout("/layouts/boilerplate") %>

<form method="POST" action="/foods/<%= food._id %>?_method=PUT" class="needs-validation" aria-describedby="required-note" novalidate>
    <h1>Edit food listing</h1>
    <p id="required-note" class="form-note">Fields marked with <span aria-hidden="true">*</span> are required.</p>
    <label for="name">Food Item Name <span aria-hidden="true">*</span></label>
    <input class="form-control" type="text" id="name" name="food[name]" value="<%= food.name %>" aria-describedby="name-feedback" required>
    <div class="invalid-feedback" id="name-feedback">Please enter the food item name.</div>

    <label for="quantity">Quantity <span aria-hidden="true">*</span></label>
    <input class="form-control" type="number" id="quantity" name="food[quantity]" value="<%= food.quantity %>" min="1" aria-describedby="quantity-feedback" required>
    <div class="invalid-feedback" id="quantity-feedback">Enter a quantity of at least 1.</div>

    <label for="type">Type <span aria-hidden="true">*</span></label>
    <select class="form-select" id="type" name="food[type]" aria-describedby="type-feedback" required>
        <option value="Vegetarian" <%= food.type === "Vegetarian" ? "selected" : "" %>>Vegetarian</option>
        <option value="Non-Vegetarian" <%= food.type === "Non-Vegetarian" ? "selected" : "" %>>Non-vegetarian</option>
    </select>
    <div class="invalid-feedback" id="type-feedback">Choose a food type.</div>

    <label for="location">Location <span aria-hidden="true">*</span></label>
    <input class="form-control" type="text" id="location" name="food[location]" value="<%= food.location %>" aria-describedby="location-feedback" required>
    <div class="invalid-feedback" id="location-feedback">Please enter the food location.</div>

    <label for="desc">Description <span aria-hidden="true">*</span></label>
    <textarea class="form-control" id="desc" name="food[description]" aria-describedby="description-feedback" required><%= food.description %></textarea>
    <div class="invalid-feedback" id="description-feedback">Please add a short description.</div>

    <label for="avail">Available Until <span aria-hidden="true">*</span></label>
    <input class="form-control" type="date" id="avail" name="food[availableUntil]" value="<%= food.availableUntil.toISOString().slice(0, 10) %>" aria-describedby="available-feedback" required>
    <div class="invalid-feedback" id="available-feedback">Choose an availability date.</div>

    <label for="provider">Food Provider <span aria-hidden="true">*</span></label>
    <input class="form-control" type="text" id="provider" name="food[providerName]" value="<%= food.providerName %>" aria-describedby="provider-feedback" required>
    <div class="invalid-feedback" id="provider-feedback">Please enter the provider name.</div>

    <label for="img">Image:</label>
    <input class="form-control" type="url" id="img" name="food[image]" value="<%= food.image %>" aria-describedby="image-feedback">
    <div class="invalid-feedback" id="image-feedback">Enter a valid image URL, or leave this optional field blank.</div>

    <button class="btn btn-primary action-button" type="submit">Save Changes</button>
</form>
