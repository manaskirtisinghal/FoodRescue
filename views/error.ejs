<% layout("/layouts/boilerplate") %>

<section class="page-shell error-shell" aria-labelledby="error-heading">
    <article class="error-card">
        <p class="eyebrow">Food Rescue · <%= statusCode %></p>
        <h1 id="error-heading">We couldn’t complete that request</h1>
        <p class="error-message" role="alert"><%= message %></p>
        <div class="error-actions">
            <a class="btn btn-primary action-button" href="/foods">Browse food</a>
            <button class="btn btn-outline-secondary error-back-button" type="button" onclick="history.back()">Go back</button>
        </div>
    </article>
</section>
